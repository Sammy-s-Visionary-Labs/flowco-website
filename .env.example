# Public GA4 web-stream Measurement ID. Empty disables analytics completely.
# This is a public identifier, not an API token or secret.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Search Console HTML-tag verification value (the content value only).
GOOGLE_SITE_VERIFICATION=

# Server-only Resend credential. The verified sender and testing recipient are
# static application configuration; never expose this key with NEXT_PUBLIC_.
RESEND_API_KEY=
